---
// (Cloudflare serves the built 404.html for any missing page)
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex hideCta>
  <section class="error-section" aria-labelledby="error-title">
    <div class="container text-center">
      <p class="error-code" aria-hidden="true">404</p>
      <h1 id="error-title" class="error-title">That page isn&rsquo;t here</h1>
      <p class="error-text">
        The link may be old, or the address may have a typo.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary"
          >Back to Home<i class="fas fa-arrow-right" aria-hidden="true"></i></a
        >
        <a href="/contact" class="btn-primary-link">Contact Me</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-section {
    padding: 140px 0 160px;
    background: var(--surface-base);
  }
  .error-code {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 900;
    line-height: 1;
    color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }
  .error-title {
    margin: 8px 0 12px;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--text-main);
  }
  .error-text {
    margin: 0 0 32px;
    color: var(--text-muted);
  }
  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }
  .btn-primary-link {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-primary);
  }
  .btn-primary-link:hover,
  .btn-primary-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
